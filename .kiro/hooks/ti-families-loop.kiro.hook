{
  "enabled": false,
  "name": "TI Families Build Loop",
  "description": "Autonomous continuation for building 8 TI engine families sequentially. Each family: V1 build → V1.1 iterate → validate → commit → next family.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "You are building 8 TI engine families per .kiro/specs/ti-families-build/tasks.md. Check which family is next (unchecked tasks), execute its V1 build cycle (define signal → build configs → run sweep → iterate V1.1 → validate → commit), then move to the next family. Work autonomously until all 8 families are done."
  }
}
