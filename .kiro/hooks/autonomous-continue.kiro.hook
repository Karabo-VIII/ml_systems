{
  "enabled": true,
  "name": "Autonomous Continuation",
  "description": "When the agent stops, remind it to continue working on the active spec tasks. This enables autonomous 6-hour work sessions without requiring user intervention between each response.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "You are in a 6-hour autonomous work session on the TI engine rebuild spec (.kiro/specs/ti-engine-rebuild/tasks.md). Check the task list, pick up the next incomplete task, execute it, commit results, and continue. Do NOT stop until all tasks are complete or 6 hours have elapsed. Current progress: EMA/HMA/DEMA sweep done at all TFs. Next: deep-dive on 2h/4h winners (random-entry null, per-asset breakdown, 3d slices), then expand remaining MA types, then iterate on best cells."
  }
}