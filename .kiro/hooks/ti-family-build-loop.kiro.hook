{
  "enabled": true,
  "name": "TI Family Build Loop",
  "description": "Autonomous loop for building 8 TI engine families sequentially. After each response, checks tasks.md for the next incomplete family and continues building.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "You are building 8 TI engine families sequentially (spec: .kiro/specs/ti-families-build/tasks.md). Check the task list, find the CURRENT family being worked on (first family with unchecked items), and continue building it. When a family is complete, commit and move to the next. NO OOS data — DEV window only. Work autonomously until all 8 families are done."
  }
}