 "audit_verdict": {
  "auditor": "Claude (RED team), 2026-06-28",
  "claim": "ADX|1d (lb22-28, thr0.42-0.48) is a genuine SELECTIVE engine (deploy 40-67%), VAL/OOS-consistent, 100th-pct null, directional gradient not a spike. PROVISIONAL.",
  "verdict": "PASS (provisional, with demotion caveat)",
  "reproduced": {
   "VAL_edge_pp_range": "+2.34..+4.32 (claim +2.7-3.8) MATCHES",
   "OOS_edge_pp_range": "+0.13..+1.85 (claim +0.6-1.1) MATCHES, peak lb26/thr0.42 +1.85",
   "deploy_OOS": "0.32..0.63 = genuinely selective (claim 40-67) MATCHES",
   "null_100pct": "reproduced; lb26/thr0.42 + most lb>=24 cells hit 100th-pct even at 500 draws"
  },
  "key_findings": {
   "VAL_fit_concern": "CONFIRMED but not fatal: edge shrinks 72-87% VAL->OOS (median ~76%); only lb26/thr0.42 holds (42% shrink). Most of the edge IS in-sample, BUT OOS stays POSITIVE + null-beating.",
   "regime_leak_robust": "The same replay() same-bar regime leak (lines 192-197) that haircut the MA band ~15% barely touches ADX: de-leak (regime.shift(1)) leaves all cells essentially unchanged and IMPROVES nulls (more cells pass >=95). Only weakest cell lb22/thr0.48 flips +0.13->-0.02. ADX selectivity insulates it from the leak.",
   "directional_gradient": "CONFIRMED genuine, not a spike. lb16=-0.82 (null 1), lb18-20~flat, lb>=22 consistently positive, peak lb26 (+1.85). Monotone-ish in lookback = mechanically coherent (needs long window to measure trend strength).",
   "selection_skill_isolated": "STRONGEST evidence: with NO regime gate, ADX|1d lb26/thr0.42 still beats always-long by +1.57pp/wk AND beats deploy-matched random null 100th-pct (compound +136% vs null median +46%). The edge is genuine ADX asset-selection, NOT the regime gates bull tilt.",
   "consistency_ceiling": "OOS pct_7d_profitable only 28-31% even on the best cell -> right-skewed (few big winners carry it), same structural low-hit-rate as the North Star Reckoning 34% ceiling. NOT a consistency engine.",
   "small_sample": "OOS = 230 daily bars (~7.5mo), only 32 non-overlapping 7d slices. Single OOS window. Edge magnitude is fragile to sample; 2025 confirmation MANDATORY before any size."
  },
  "most_important_finding": "ADX|1d is a GENUINE selective edge (survives de-leak, no-gate null, and the directional-gradient overfit probe) -- but ~76% of its headline edge is in-sample VAL-fit and OOS rests on a single 230-bar window with 28-31% 7d-hit-rate. KEEP as PROVISIONAL-SELECTIVE ensemble (lb24-28 x thr0.42-0.45), do NOT size, and the 2025 re-confirm is load-bearing, not optional.",
  "recommendation": "KEEP provisional. Deploy ONLY as ensemble over lb{24,26,28} x thr{0.42,0.45} (drop thr0.48 cells: null-marginal and de-leak-fragile; drop lb<22: dead). Re-baseline any headline to the OOS ~+0.9-1.2pp/wk (NOT the VAL +3-4pp). Block size until 2025 confirms."
