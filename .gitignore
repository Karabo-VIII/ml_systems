# New root. The pre-rebuild project is ml_systems_v1/ and keeps the
# rules below, rewritten so ignored data stays ignored under that folder.
__pycache__/
.pytest_cache/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.DS_Store
Thumbs.db

# Banned binaries and large-data extensions. Also enforced by scripts/pre_commit_guard.py.
*.parquet
*.pt
*.pth
*.pkl
*.pickle
*.npz
*.npy
*.bin

# New pipeline working directories. Created at runtime, not committed.
/data/
/data_verify/
/runs/

# Local trees left on disk from before the flat rebuild (the tracked copy is
# ml_systems_v1/), per-machine Claude Code state, and scratch output.
/.claude/
/archive/
/crypto/
/dataclear/
/games/
/scratch_out*.txt

# ---------------------------------------------------------------------------
# Archived tree. Each path-specific rule from the pre-rebuild gitignore is
# prefixed with ml_systems_v1/ so the same data stays untracked after git mv.
# Patterns with no slash were left global above or repeated unchanged.
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Data (too large for git) — post-2026-04-26 layout
ml_systems_v1/data/raw/
ml_systems_v1/data/raw_external/
# all gold + silver: chimera/, chimera_legacy/, frontier/, bars/, hawkes/, panels/
ml_systems_v1/data/processed/
ml_systems_v1/data/lob/

# Per-build manifests (small JSON; regenerable)
ml_systems_v1/data/manifests/

# Legacy dirs (deleted in 2026-04-26 migration; kept ignored in case of partial restores)
ml_systems_v1/data/frontier/
ml_systems_v1/data/features/
ml_systems_v1/data/bars/
ml_systems_v1/data/_manifests/
ml_systems_v1/data/_config/
ml_systems_v1/data/universes/
ml_systems_v1/data/twin_bars/
ml_systems_v1/data/ml_training/

# TrainingLoader normalization stat cache (regenerable; computed lazily)
ml_systems_v1/data/_normalizers/

# Pipeline DAG runner state (runtime, regenerable from refresh.py)
ml_systems_v1/data/_dag_state.json
ml_systems_v1/data/_dag_state_live.json

# Production / paper-trader runtime state (NOT source; regenerable)
ml_systems_v1/data/prod/
ml_systems_v1/data/prod_state/

# (Universe specs moved to config/universes/ in 2026-04-26 layout cleanup)

# Model checkpoints (too large for git)
models/

# Logs (regenerated)
logs/

# Plots (regenerated)
plots/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Backup snapshots & temp archives (contain models, too large for git)
ml_systems_v1/backups/BKP*/
ml_systems_v1/backups/TMP/
ml_systems_v1/backups/TMP_*/
ml_systems_v1/backups/v4_crypto_system_bkp_*/
reports/

# Temp files
_tmp_*
_b64*
_decode_helper.py
_preflight_check.py

# Jupyter
.ipynb_checkpoints/

# Claude agent state (session-specific)
ml_systems_v1/.claude/agent_state/briefings/

# Claude Code local settings (per-machine)
ml_systems_v1/.claude/settings.json
ml_systems_v1/.claude/settings.json.bak*
ml_systems_v1/.claude/settings.local.json
ml_systems_v1/.claude/settings.local.json.bak*
ml_systems_v1/.claude/scheduled_tasks.lock
ml_systems_v1/.claude/scheduled_tasks/

# CatBoost training artifacts (regenerated every run — noise)
catboost_info/

# Oracle analysis outputs (regenerable from scripts/oracle/*.py)
# Source scripts ARE tracked; outputs are not (they're large/noisy/regenerable).
ml_systems_v1/data/oracle/*.csv
ml_systems_v1/data/oracle/*.json
ml_systems_v1/data/oracle/_BROKEN_CATALOGS_PRE_AUDIT_*/

# Pipeline DAG lock (runtime, regenerable)
ml_systems_v1/data/_dag_state.lock

# Training log files (regenerable; noisy)
ml_systems_v1/runs/*_log.txt
ml_systems_v1/runs/**/*.log

# Local cleanup dumps stay untracked. The v1 pipeline source archive is the
# exception: it is the git-mv of crypto/src/pipeline and must stay in history.
ml_systems_v1/archive/*
!ml_systems_v1/archive/pipeline_v1/
!ml_systems_v1/archive/pipeline_v1/**

# ============================================================================
# Defense-in-depth: catch-all binary patterns (NEVER commit large binaries)
# These are belt-and-suspenders on top of the path-specific rules above.
# Added 2026-04-30 after discovering 119GB of historical chimera parquets.
# ============================================================================
*.parquet
*.pt
*.pth
*.pkl
*.pickle
*.bin
*.npy
*.npz
*.h5
*.hdf5
*.feather
*.arrow

# Allow specific small reference files when explicitly tracked via -f
# (use `git add -f path/to/keepfile.parquet` if a small reference parquet
# really needs to be in the repo).
ml_systems_v1/external/Kronos/

# Large TA-SML training outputs (regenerable from src/strategy/ta_sml/pipeline.py)
ml_systems_v1/runs/ta_sml/15m_u50/
ml_systems_v1/runs/ta_sml/1h_u50/
ml_systems_v1/runs/ta_sml/4h_u10/
ml_systems_v1/runs/ta_sml/4h_u50/
ml_systems_v1/runs/ta_sml/4h_u50_resilient/
ml_systems_v1/runs/ta_sml/live_sim/

# Large oracle-v2 training input (3.6MB; regenerable from chimera + clustering)
ml_systems_v1/runs/oracle_v2/winner_events.parquet
ml_systems_v1/runs/oracle_v2/emergent_clusters.parquet
ml_systems_v1/runs/oracle_v2/strat_fires_*.parquet

# Large winning-formula intermediate (regenerable from step2)
ml_systems_v1/runs/winning_formula/lane_weighted_fires.parquet
ml_systems_v1/runs/winning_formula/daily_pnl_by_k.parquet

# Oracle infrastructure -- large parquets (regenerable from chimera via scripts/oracle/build_*.py)
ml_systems_v1/runs/oracle_2024_val/move_events.parquet
ml_systems_v1/runs/oracle_2024_val/move_segments_*.parquet
ml_systems_v1/runs/oracle_layer2/daily_regime_cluster.parquet
ml_systems_v1/runs/oracle_layer3/**/*.parquet
ml_systems_v1/runs/oracle_layer3/**/*.csv

# 2026-05-24: T2-A Phase 1 BTC-only experiment artifact (58MB, regenerable)
ml_systems_v1/runs/oracle/bd_bar_grain_btc_panel.parquet

# 2026-05-28: 8h-autonomous discovery outputs (203MB JSONs + PNGs, regenerable from scripts/wealth_bot/*.py)
# MD reports + INDEX.html stay tracked; bulky outputs (JSON/CSV/PNG) ignored.
ml_systems_v1/runs/discovery/**/*.json
ml_systems_v1/runs/discovery/**/*.csv
ml_systems_v1/runs/discovery/**/*.png
ml_systems_v1/runs/discovery/visual_reports*/**/*.png

ml_systems_v1/runs/autonomy/

# --- experiment/session scratch (2026-06-07 git-tree cleanup): preserved on disk, kept OUT of git ---
ml_systems_v1/experiments/adaptive_ma/_*
ml_systems_v1/experiments/adaptive_ma/**/_*
ml_systems_v1/runs/research/_*
ml_systems_v1/runs/research/**/_*
ml_systems_v1/scripts/autonomy/metaop/_*
# ...but DO version-control the metaop verification suite (the loop's trust harness must be reproducible on clone).
# 2026-06-07 audit G-H: previously `metaop/_*` silently ignored _test_/_proof_/_falsifier_ probes too.
!ml_systems_v1/scripts/autonomy/metaop/_test_*.py
!ml_systems_v1/scripts/autonomy/metaop/_proof_*.py
!ml_systems_v1/scripts/autonomy/metaop/_falsifier_*.py
ml_systems_v1/runs/staging/directive_proposals/_last_write.txt
ml_systems_v1/**/*OUT.txt
ml_systems_v1/**/*.bak

# chess self-play visualizer regenerable outputs
ml_systems_v1/games/az/selfplay_viz.html
ml_systems_v1/games/az/selfplay_viz_data.json
ml_systems_v1/games/az/az_demo_checkpoints/
# checkpoint dirs (too large for git; ~76GB+ -- regenerable). The previous rule here was a
# malformed env-var-style assignment (ROBUST_CKPT=...) that matched nothing, leaving these exposed.
ml_systems_v1/games/az/robust_checkpoints/
ml_systems_v1/games/az/bootstrap_checkpoints/
ml_systems_v1/games/az/robust_anchored/
ml_systems_v1/games/az/robust_fast/
ml_systems_v1/games/az/robust_from_bootstrap/
# stale run-state / logs (advertise a dead run as live; regenerable)
ml_systems_v1/games/az/train_supervisor.pid
ml_systems_v1/games/az/train_run.log
ml_systems_v1/games/az/train_run.err
ml_systems_v1/games/az/_real_boot.log

# ============================================================================
# 2026-06-09 git-tree cleanup (overseer): transient / large / scratch -> on-disk only, never tracked.
# (Foundational decomposition EVIDENCE in runs/mining/*.json|csv IS committed; the FINDINGS docs are tracked.)
# ============================================================================
# Harness run outputs (regenerable)
.harness_runs/
# Root eval-harness cwd-leak artifacts (oracle benchmark task files that escaped the temp build dir;
# current eval code uses isolated tempfile.mkdtemp -> these are stale leakage, regenerable)
/compute.py
/mathlib.py
/tmp_proto_*.py
# Oracle analysis raw outputs + scratch probes (regenerable from src/oracle/*.py; runs/oracle/decisions.md stays tracked)
ml_systems_v1/runs/oracle/_*
ml_systems_v1/runs/oracle/*.csv
ml_systems_v1/runs/oracle/*.out
ml_systems_v1/runs/oracle/*.err
ml_systems_v1/runs/oracle/leaderboard_partial.txt
# Strat probe self-test + fixture outputs (regenerable from src/strat/*.py)
ml_systems_v1/runs/strat/*_selftest_*
ml_systems_v1/runs/strat/*FIXTURE*
ml_systems_v1/runs/strat/exit_capture_*
# Research feature dumps (regenerable; runs/research/*REPORT*.md stays tracked)
ml_systems_v1/runs/research/*_dump.json
# Staging = scratch workspace (commit-msg drafts, smoke scripts, .bak backups, one-off experiments)
ml_systems_v1/runs/staging/
# Chess side-project run artifacts (the existing rules missed robust_dual/ = 2.3GB of checkpoints)
ml_systems_v1/runs/autonomy/_proof_fib.py
ml_systems_v1/games/az/robust_dual/
ml_systems_v1/games/az/robust_anchored_dual/
ml_systems_v1/games/az/bootstrap_d4_run.*
ml_systems_v1/games/az/strength_curve.json
ml_systems_v1/games/az/*.bak.*
# chess_zero training run dirs + checkpoints (regenerable, large) -- GLOB so ANY new run-dir
