ml_systems_v1/games/az/robust_*/
ml_systems_v1/games/az/*_checkpoints/
ml_systems_v1/games/az/*/heartbeat.json
ml_systems_v1/games/az/*/strength_curve.json
# dualnull scratch experiment
ml_systems_v1/projects/dualnull/

ml_systems_v1/runs/strat/ma_per_instrument_u10_*.json
ml_systems_v1/runs/strat/ma_mechanics.json
ml_systems_v1/runs/strat/ma_mechanics_maker.json

